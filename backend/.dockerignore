# ============================================
# SRM Attendance Tracker - .dockerignore
# ============================================

# Git
.git
.gitattributes
.gitignore

# Build artifacts
target/
*.jar
*.war

# IDE files
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.factorypath
.springBeans

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Docker
Dockerfile
.dockerignore

# Logs
*.log

# Firebase service account key — NEVER include in Docker image!
# Pass this via Render's Secret Files or volume mount at runtime
firebase/serviceAccountKey.json

# Environment files
.env
.env.local
.env.production

# Node (if any frontend artifacts in backend)
node_modules/



